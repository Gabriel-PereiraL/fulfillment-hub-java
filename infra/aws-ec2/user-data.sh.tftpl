#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/fulfillment-hub-bootstrap.log | logger -t user-data -s 2>/dev/console) 2>&1

dnf update -y
dnf install -y docker
systemctl enable --now docker

install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/download/v5.6.0/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
echo "40343e21ca777173e69cff5dbafeb37c6f81f3b0d57d9e597f036e95eb63e76a  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c -
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose

install -d -m 0700 /opt/fulfillment-hub
echo '${compose_yaml_b64}' | base64 -d > /opt/fulfillment-hub/compose.yaml

cat > /opt/fulfillment-hub/deploy.sh <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
cd /opt/fulfillment-hub

parameter() {
  aws ssm get-parameter --region "$${AWS_REGION}" --name "$${PARAMETER_PATH}/$1" --with-decryption --query Parameter.Value --output text
}

umask 077
cat > .env <<ENV
AWS_REGION=$${AWS_REGION}
PUBLIC_HOSTNAME=$${PUBLIC_HOSTNAME}
DATABASE_PASSWORD=$(parameter database-password)
JWT_SIGNING_KEY=$(parameter jwt-signing-key)
PAYMENT_WEBHOOK_KEY=$(parameter payment-webhook-key)
DELIVERY_WEBHOOK_KEY=$(parameter delivery-webhook-key)
PROVIDER_TOKEN=$(parameter provider-token)
SEED_ADMIN_PASSWORD=$(parameter seed-admin-password)
SEED_CUSTOMER_PASSWORD=$(parameter seed-customer-password)
ENV

aws s3 cp --region "$${AWS_REGION}" "s3://$${ARTIFACT_BUCKET}/$${ARTIFACT_KEY}" images.tar
docker load --input images.tar
rm -f images.tar

docker compose up -d --wait postgres
docker compose run --rm migrate
docker compose run --rm seed
docker compose up -d --wait provider-simulator api
docker compose up -d worker caddy
docker image prune -f
SCRIPT

sed -i \
  -e 's|$${AWS_REGION}|${aws_region}|g' \
  -e 's|$${PARAMETER_PATH}|${parameter_path}|g' \
  -e 's|$${PUBLIC_HOSTNAME}|${public_hostname}|g' \
  -e 's|$${ARTIFACT_BUCKET}|${artifact_bucket}|g' \
  -e 's|$${ARTIFACT_KEY}|${artifact_key}|g' \
  /opt/fulfillment-hub/deploy.sh
chmod 0700 /opt/fulfillment-hub/deploy.sh

cat > /etc/systemd/system/fulfillment-hub-deploy.service <<'UNIT'
[Unit]
Description=Deploy Fulfillment Hub Java from its private S3 artifact
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/fulfillment-hub/deploy.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable fulfillment-hub-deploy.service

# The artifact is uploaded after Terraform creates the private bucket. The
# deployment script triggers the service through Systems Manager at that point.
